0;    continueRoutine = False&amp;#10;&amp;#10;if currentTime &gt;= maxTime:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;if 'escape' in event.getKeys():&amp;#10;    core.quit()" valType="extendedCode" updates="constant" name="Each Frame"/>
