        <Param val="trialClock = core.Clock()&amp;#10;roiClock = core.Clock()&amp;#10;videoStarted = False&amp;#10;videoStartTime = None&amp;#10;gazeTime = 0&amp;#10;gazeInROI = False&amp;#10;continueRoutine = True&amp;#10;sampleIndex = 0&amp;#10;# Get video stim&amp;#10;central_fixation.setAutoDraw(False)&amp;#10;central_fixation.stop()&amp;#10;central_fixation.seek(0)&amp;#10;# play sound&amp;#10;attention_sound = sound.Sound(r'materials\\attention_sound.wav')&amp;#10;attention_sound.setVolume(1.0)&amp;#10;soundPlayed = False&amp;#10;# Get aspect ratio&amp;#10;aspect = win.size[0] / win.size[1]&amp;#10;&amp;#10;# Define ROI&amp;#10;x0 = -aspect / 2&amp;#10;x1 =  aspect / 2&amp;#10;y0 = -0.5&amp;#10;y1 =  0.5&amp;#10;&amp;#10;print('Attention check started')&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
