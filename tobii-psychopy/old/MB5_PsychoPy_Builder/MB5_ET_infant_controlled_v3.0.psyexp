      <CodeComponent name="code_attention_check" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="trialClock = new util.Clock();&amp;#10;roiClock = new util.Clock();&amp;#10;videoStarted = false;&amp;#10;videoStartTime = null;&amp;#10;gazeTime = 0;&amp;#10;gazeInROI = false;&amp;#10;continueRoutine = true;&amp;#10;sampleIndex = 0;&amp;#10;baby_video.setAutoDraw(false);&amp;#10;baby_video.stop();&amp;#10;baby_video.seek(0);&amp;#10;baby_sound = new sound.Sound(&quot;materials\\\\baby_sound.wav&quot;);&amp;#10;baby_sound.setVolume(1.0);&amp;#10;soundPlayed = false;&amp;#10;aspect = (psychoJS.window.size[0] / psychoJS.window.size[1]);&amp;#10;x0 = ((- aspect) / 2);&amp;#10;x1 = (aspect / 2);&amp;#10;y0 = (- 0.5);&amp;#10;y1 = 0.5;&amp;#10;console.log(&quot;Attention check started&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ---------- BEGIN ROUTINE ----------&amp;#10;trialClock = core.Clock()&amp;#10;roiClock = core.Clock()&amp;#10;videoStarted = False&amp;#10;videoStartTime = None&amp;#10;gazeTime = 0&amp;#10;gazeInROI = False&amp;#10;continueRoutine = True&amp;#10;sampleIndex = 0&amp;#10;# Load Video Stim&amp;#10;baby_video.setAutoDraw(False)&amp;#10;baby_video.stop()&amp;#10;baby_video.seek(0)&amp;#10;# Reset Audio Stim&amp;#10;baby_sound = sound.Sound(r'materials\\baby_sound.wav')&amp;#10;baby_sound.setVolume(1.0)&amp;#10;soundPlayed = False&amp;#10;&amp;#10;# Get aspect ratio&amp;#10;aspect = win.size[0] / win.size[1]&amp;#10;&amp;#10;# Define ROI&amp;#10;x0 = -aspect / 2&amp;#10;x1 =  aspect / 2&amp;#10;y0 = -0.5&amp;#10;y1 =  0.5&amp;#10;&amp;#10;print('Attention check started')" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# Get current time&amp;#10;currentTime = trialClock.getTime()&amp;#10;# Get current gaze&amp;#10;gazePos = get_current_gaze()&amp;#10;&amp;#10;if gazePos is not None:&amp;#10;    gazeX, gazeY = gazePos&amp;#10;    # Check if gaze is anywhere on the screen ROI&amp;#10;    if x0 &lt;= gazeX &lt;= x1 and y0 &lt;= gazeY &lt;= y1:&amp;#10;        if not videoStarted:&amp;#10;            baby_video.setAutoDraw(True)&amp;#10;            baby_video.play()&amp;#10;            videoStarted = True&amp;#10;            videoStartTime = t&amp;#10;            if not soundPlayed:&amp;#10;                baby_sound.play()&amp;#10;                soundPlayed = True&amp;#10;else:&amp;#10;    gazeX, gazeY = None, None&amp;#10;    &amp;#10;# ---------- SAVE RAW GAZE SAMPLE ----------&amp;#10;&amp;#10;sampleIndex += 1&amp;#10;thisExp.addData('gaze_sample_index', sampleIndex)&amp;#10;thisExp.addData('gaze_time', currentTime)&amp;#10;# Make a safe copy of latest_gaze to prevent thread issues&amp;#10;current_sample = latest_gaze.copy() if latest_gaze else None&amp;#10;# Save all raw gaze fields from latest_gaze&amp;#10;if current_sample is not None:&amp;#10;    keys = list(current_sample.keys())&amp;#10;    for k in keys:&amp;#10;        thisExp.addData(k, current_sample[k])&amp;#10;else:&amp;#10;    thisExp.addData('no_gaze_data', 1)&amp;#10;&amp;#10;# End routine after 3 seconds&amp;#10;if videoStarted and videoStartTime is not None:&amp;#10;    if t - videoStartTime &gt;= 3.0:&amp;#10;        continueRoutine = False&amp;#10;        &amp;#10;# Optional: allow escape key to quit experiment&amp;#10;if 'escape' in event.getKeys():&amp;#10;    core.quit()&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;currentTime = trialClock.getTime();&amp;#10;gazePos = get_current_gaze();&amp;#10;if ((gazePos !== null)) {&amp;#10;    [gazeX, gazeY] = gazePos;&amp;#10;    if ((((x0 &lt;= gazeX) &amp;&amp; (gazeX &lt;= x1)) &amp;&amp; ((y0 &lt;= gazeY) &amp;&amp; (gazeY &lt;= y1)))) {&amp;#10;        if ((! videoStarted)) {&amp;#10;            baby_video.setAutoDraw(true);&amp;#10;            baby_video.play();&amp;#10;            videoStarted = true;&amp;#10;            videoStartTime = t;&amp;#10;            if ((! soundPlayed)) {&amp;#10;                baby_sound.play();&amp;#10;                soundPlayed = true;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    [gazeX, gazeY] = [null, null];&amp;#10;}&amp;#10;sampleIndex += 1;&amp;#10;psychoJS.experiment.addData(&quot;gaze_sample_index&quot;, sampleIndex);&amp;#10;psychoJS.experiment.addData(&quot;gaze_time&quot;, currentTime);&amp;#10;current_sample = (latest_gaze ? latest_gaze.copy() : null);&amp;#10;if ((current_sample !== null)) {&amp;#10;    keys = list(current_sample.keys());&amp;#10;    for (var k, _pj_c = 0, _pj_a = keys, _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        k = _pj_a[_pj_c];&amp;#10;        psychoJS.experiment.addData(k, current_sample[k]);&amp;#10;    }&amp;#10;} else {&amp;#10;    psychoJS.experiment.addData(&quot;no_gaze_data&quot;, 1);&amp;#10;}&amp;#10;if ((videoStarted &amp;&amp; (videoStartTime !== null))) {&amp;#10;    if (((t - videoStartTime) &gt;= 3.0)) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;if (_pj.in_es6(&quot;escape&quot;, psychoJS.eventManager.getKeys())) {&amp;#10;    core.quit();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="baby_video.stop();&amp;#10;baby_sound.stop();&amp;#10;baby_video.seek(0);&amp;#10;baby_video.setAutoDraw(false);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="baby_video.stop()&amp;#10;baby_sound.stop()&amp;#10;baby_video.seek(0)&amp;#10;baby_video.setAutoDraw(False)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_attention_check" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
