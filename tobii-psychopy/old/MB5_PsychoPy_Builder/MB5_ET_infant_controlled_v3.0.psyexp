        <Param val="trialClock = new util.Clock();&amp;#10;roiClock = new util.Clock();&amp;#10;gazeTime = 0;&amp;#10;sampleIndex = 0;&amp;#10;inROI = 0;&amp;#10;gazeInROI = false;&amp;#10;fam_sound = new sound.Sound(&quot;materials\\\\familiarization_sound.wav&quot;);&amp;#10;fam_sound.setVolume(1.0);&amp;#10;fam_sound.play();&amp;#10;[x0, y0] = [(ROI_Familiarization.pos[0] - (ROI_Familiarization.size[0] / 2)), (ROI_Familiarization.pos[1] - (ROI_Familiarization.size[1] / 2))];&amp;#10;[x1, y1] = [(ROI_Familiarization.pos[0] + (ROI_Familiarization.size[0] / 2)), (ROI_Familiarization.pos[1] + (ROI_Familiarization.size[1] / 2))];&amp;#10;minTime = Number.parseFloat(fam_IC_time);&amp;#10;maxTime = Number.parseFloat(fam_max_time);&amp;#10;console.log(&quot;Fam started&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Timer for this trial&amp;#10;trialClock = core.Clock()  # overall max display time&amp;#10;roiClock = core.Clock()    # timer for fixation in ROI&amp;#10;&amp;#10;# Gaze tracking&amp;#10;gazeTime = 0  # will store the gaze time inside ROI&amp;#10;sampleIndex = 0&amp;#10;inROI = 0&amp;#10;gazeInROI = False&amp;#10;&amp;#10;fam_sound = sound.Sound(r'materials\\familiarization_sound.wav')&amp;#10;fam_sound.setVolume(1.0)&amp;#10;#print(&quot;Duration:&quot;, Fam.getDuration())&amp;#10;fam_sound.play()&amp;#10;&amp;#10;# Define ROI&amp;#10;x0, y0 = ROI_Familiarization.pos[0] - ROI_Familiarization.size[0]/2, ROI_Familiarization.pos[1] - ROI_Familiarization.size[1]/2&amp;#10;x1, y1 = ROI_Familiarization.pos[0] + ROI_Familiarization.size[0]/2, ROI_Familiarization.pos[1] + ROI_Familiarization.size[1]/2&amp;#10;&amp;#10;# Read times from Excel&amp;#10;minTime = float(fam_IC_time)   # time required in ROI to end routine&amp;#10;maxTime = float(fam_max_time)  # maximum trial duration&amp;#10;&amp;#10;print('Fam started')" valType="extendedCode" updates="constant" name="Begin Routine"/>
